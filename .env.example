# Copie este arquivo para ".env.local" e preencha com os dados do SEU
# projeto Supabase. O ".env.local" nunca vai pro GitHub (está no
# .gitignore) — é só pra rodar no seu computador. Na Vercel, essas mesmas
# variáveis são configuradas na tela do projeto (Settings > Environment
# Variables), não em arquivo.

# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xkewjkjldtfzsvqvxgte.supabase.co

# Chave pública ("publishable"/"anon") do projeto (Project Settings > API)
# — é segura para expor no navegador: as regras de segurança (RLS) do
# banco são o que realmente protege os dados, não esta chave.
VITE_SUPABASE_ANON_KEY=sb_publishable_RokuarBTLwKnLiIKF4AM0g_MyQwgqrN

# Identifica QUAL loja este painel administra (coluna "slug" da tabela
# "lojas"). Um painel novo para outro cliente só precisa trocar este valor
# (e as duas chaves acima, se for um projeto Supabase diferente).
VITE_LOJA_SLUG=donna-donno
